{
  "name": "timbrado",
  "version": "0.1.0",
  "description": "Run your own gates against the heads, nightlies, nexts and canaries of what you depend on, watch for the upstream fixes you are waiting on, and read what a pin adopts before you move it. Proposes nothing.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "timbrado": "./dist/cli.js"
  },
  "scripts": {
    "test": "bun scripts/build.ts && bun test conformance",
    "test:live": "TIMBRADO_LIVE=1 bun test conformance",
    "timbrado": "bun src/cli.ts",
    "build": "bun scripts/build.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    "./registry": {
      "types": "./src/registry.ts",
      "bun": "./src/registry.ts",
      "default": "./dist/registry.js"
    },
    "./resolve": {
      "types": "./src/resolve.ts",
      "bun": "./src/resolve.ts",
      "default": "./dist/resolve.js"
    },
    "./survey": {
      "types": "./src/survey.ts",
      "bun": "./src/survey.ts",
      "default": "./dist/survey.js"
    },
    "./digest": {
      "types": "./src/digest.ts",
      "bun": "./src/digest.ts",
      "default": "./dist/digest.js"
    },
    "./watch": {
      "types": "./src/watch.ts",
      "bun": "./src/watch.ts",
      "default": "./dist/watch.js"
    },
    "./isolate": {
      "types": "./src/isolate.ts",
      "bun": "./src/isolate.ts",
      "default": "./dist/isolate.js"
    },
    "./report": {
      "types": "./src/report.ts",
      "bun": "./src/report.ts",
      "default": "./dist/report.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "registry",
    "README.md",
    "LICENSE"
  ]
}
